      "id": 1,
      "prompt": "用 phases.json 整理缺陷验证状态，输出 eval-result.json：status、missing_phases、reason。不要执行应用或编造旧版证据。",
      "expected_output": "缺 RED，不能 verified。",
      "files": [
        {
          "path": "phases.json",
          "content": "{\n  \"red\": null,\n  \"green\": {\n    \"status\": \"passed\",\n    \"build\": \"synthetic-new\"\n  },\n  \"regression\": {\n    \"status\": \"passed\",\n    \"build\": \"synthetic-new\"\n  }\n}\n"
        }
      ],
      "assertions": [
        {
          "id": "incomplete",
          "text": "incomplete",
          "check": "programmatic",
          "script": "python3 -c 'import json; from pathlib import Path; d=json.loads(Path('\"'\"'eval-result.json'\"'\"').read_text()); assert d['\"'\"'status'\"'\"']=='\"'\"'incomplete'\"'\"''"
        },
        {
          "id": "missing-red",
          "text": "missing-red",
          "check": "programmatic",
          "script": "python3 -c 'import json; from pathlib import Path; d=json.loads(Path('\"'\"'eval-result.json'\"'\"').read_text()); assert '\"'\"'red'\"'\"' in d['\"'\"'missing_phases'\"'\"']'"
