{
  "info": {
    "name": "Mini Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.example.invalid"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status', function () {});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health?verbose=true",
              "path": [
                "health"
              ],
              "query": [
                {
                  "key": "verbose",
                  "value": "true"
                }
              ]
            }
          },
          "response": [
            {
              "name": "ok",
              "code": 200,
              "body": "{\"status\":\"ok\"}"
            }
          ]
        }
      ]
    }
  ]
}
